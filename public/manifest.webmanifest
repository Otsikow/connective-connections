{
  "name": "Connective - Real Friends. Real Connection.",
  "short_name": "Connective",
  "description": "Find meaningful friendships through AI-powered compatibility matching. Connect with real people, join local events, and build genuine relationships in a safe community.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait",
  "background_color": "#44337a",
  "theme_color": "#44337a",
  "categories": ["social", "lifestyle"],
  "id": "/",
  "lang": "en-US",
  "icons": [
    {
      "src": "/pwa-icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/favicon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Explore Connections",
      "short_name": "Connections",
      "description": "Browse curated matches and community spotlights.",
      "url": "/#discover",
      "icons": [
        {
          "src": "/pwa-icon.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Join Events",
      "short_name": "Events",
      "description": "Find local meetups that fit your vibe.",
      "url": "/#events",
      "icons": [
        {
          "src": "/pwa-icon.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ]
    }
  ],
  "prefer_related_applications": false
}
